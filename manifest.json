{
  "manifest_version": 3,
  "name": "Meet Transcript Saver",
  "version": "0.1.0",
  "description": "Save visible Google Meet live captions locally and export them as Markdown or JSON.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_title": "Meet Transcript Saver",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/transcript-core.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
